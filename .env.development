# Development Environment Variables for Debugging
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FILE=logs/quantum_banking.log

# Database
DATABASE_URL=sqlite:///./quantum_banking.db

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-for-development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:8501

# Quantum Computing Configuration
QISKIT_BACKEND=aer_simulator
QUANTUM_SHOTS=1024

# Development flags
ENABLE_CORS=true
RELOAD_ON_CHANGE=true
